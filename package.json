{
    "name": "sathvik-harika-wedding",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/local.ts\"",
        "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/build-worker.mjs",
        "lint": "eslint .",
        "preview": "tsx server/local.ts --production",
        "test": "node --import tsx --test tests/*.test.ts",
        "test:e2e": "playwright test",
        "rsvps": "tsx scripts/manage-rsvps.ts",
        "art:optimize": "node scripts/optimize-art.mjs"
    },
    "dependencies": {
        "@fontsource/cormorant-garamond": "^5.3.0",
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/great-vibes": "^5.3.0",
        "@fontsource/noto-serif-telugu": "^5.3.0",
        "@gsap/react": "^2.1.2",
        "@hookform/resolvers": "^6.0.1",
        "@tanstack/react-query": "^5.105.0",
        "gsap": "^3.15.0",
        "lenis": "^1.3.27",
        "lucide-react": "^1.62.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "sharp": "^0.35.5",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.5"
    }
}
