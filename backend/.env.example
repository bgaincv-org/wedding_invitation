NODE_ENV=development
HOST=127.0.0.1
PORT=3002
MONGODB_URI=mongodb://127.0.0.1:27017/wedding
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Generate separate secrets using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Optional in a direct Node deployment; administration fails closed when omitted.
ADMIN_TOKEN=
RSVP_ENABLED=true
WEDDING_EVENT_IDS=reception,wedding
TRUST_PROXY=
LOG_LEVEL=info
# Docker Compose only: set all four secrets to different random hex strings.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
