{
  "name": "wedding-invitation-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS and MongoDB guest RSVP service",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch dist/main.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/integration.test.js",
    "lint": "eslint src test",
    "test:container": "node scripts/verify-container.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.11.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
